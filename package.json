{
  "name": "logseq-impeller-ai",
  "version": "0.10.0",
  "type": "module",
  "description": "A universal, LLM-agnostic sidebar assistant for Logseq. Features a native sidebar chat interface, agentic RAG tools (semantic search, graph queries, web search), and task cancellation control.",
  "main": "dist/index.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "bump": "node scripts/bump-version.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@logseq/libs": "^0.0.17",
    "@types/dompurify": "^3.2.0",
    "jsdom": "^25.0.1",
    "terser": "^5.48.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  },
  "author": "TinkerPump (Hanson)",
  "logseq": {
    "id": "logseq-impeller-ai",
    "title": "Impeller AI: Universal LLM Sidebar",
    "icon": "./logo.png",
    "category": "Tools"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@orama/orama": "^3.1.18",
    "dompurify": "^3.4.11",
    "highlight.js": "^11.12.0",
    "marked": "^18.0.5"
  }
}
